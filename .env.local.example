NEXT_PUBLIC_API_URL=http://localhost:3002

# Porta do frontend (usada no Docker)
# Backend roda na 3002, frontend na 3003
PORT=3003

# true = registra Service Worker também em npm run dev (testar push local)
ENABLE_PWA_DEV=true

# Web Push (mesma VAPID_PUBLIC_KEY do backend)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
